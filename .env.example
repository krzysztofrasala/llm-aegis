# ---------------------------------------------------------------------------
# LLM Aegis configuration
# Copy this file to `.env` and adjust. CLI flags override these values.
# ---------------------------------------------------------------------------

# --- Target model (the system under test) ----------------------------------
# Provider: "ollama" (local, default, no API key needed) or "api" (cloud).
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Only used when LLM_PROVIDER=api (OpenAI, Groq, Gemini, Anthropic-compatible, ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Local Ollama daemon (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Judge model (the evaluator for `llm_judge` assertions) ----------------
# Every JUDGE_* value falls back to the matching target value when left empty.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=

# --- Request tuning --------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=60
# Output budget for the target model's answers.
MAX_TOKENS=512
# Output budget for the judge. Reasoning models (gpt-oss, qwen) "think" before
# answering and may return no verdict if this is too low.
JUDGE_MAX_TOKENS=2048
